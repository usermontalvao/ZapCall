# ZapCall — environment (see docs/<lang>/environment.md for every variable)

# ---- Manager (npm start = src/manager.mjs)
PORT=18475
# Bind address. Keep on the loopback; with Docker host networking 0.0.0.0 would expose the API.
HOST=127.0.0.1
# Global key (header `apikey`): administers every instance and opens the panel.
# Empty = generated on first boot and stored in DATA_DIR/manager.json (mode 0600).
ZAPCALL_API_KEY=
# Where instances.json, manager.json and the Chrome profiles (paired sessions) live.
DATA_DIR=/data
# First loopback port for instances; each instance takes the next free one.
INSTANCE_PORT_BASE=18500
# Country code prepended to 10-11-digit national numbers (55, 1, 34...). Empty = national numbers are rejected.
DEFAULT_COUNTRY_CODE=
# Comma-separated browser origins allowed on CORS and WebSocket. Empty = any origin.
ALLOWED_ORIGINS=
# 1 = instance logs also on the manager's stdout (they are always available in the panel).
VERBOSE=1
# Chrome binary. Autodetected on Linux and macOS; must be Chrome (H.264), not Chromium.
CHROME_PATH=
# Video profile: realtime (640x360@24, recommended for hosting), balanced
# (960x540@24) or hd (1280x720@30; only with measured CPU and upload).
ZAPCALL_VIDEO_PROFILE=realtime
# Optional profile overrides:
# ZAPCALL_VIDEO_WIDTH=640
# ZAPCALL_VIDEO_HEIGHT=360
# ZAPCALL_VIDEO_FPS=24
# ZAPCALL_VIDEO_BITRATE=650000
# Set to 1 only when the host has no usable /dev/shm. Compose reserves 1 GB.
CHROME_DISABLE_DEV_SHM_USAGE=0

# ---- Single instance without the manager (npm run start:single = src/app.mjs)
# Bearer token of the instance API. Empty = open API (never in production).
ZAPCALL_TOKEN=
PROFILE_DIR=/data/profile
# 1 = show the Chrome window (desktop development).
HEADFUL=0
# Pairing QR on stdout (1) and how many to print before pausing.
QR_TERMINAL=1
QR_MAX=30
# Reload the page if no fresh QR appeared for this long (safety net, ms).
QR_STALE_MS=180000
# 1 = enable POST /api/debug/eval (code execution in the session) from the loopback only. Never in production.
DEBUG_EVAL=0
