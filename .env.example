# ZapCall — variables read by docker-compose.yml (manager mode).
# Every variable, including the single-instance mode ones, is documented in
# docs/<lang>/environment.md and in the panel at /docs.

# Global key (header `apikey`): administers every instance and opens the panel.
# Empty = generated on first boot and stored in /data/manager.json (mode 0600).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ZAPCALL_API_KEY=

# Manager port. The service binds to 127.0.0.1 (host networking); put a reverse proxy in front.
PORT=18475

# First loopback port for instances; each instance takes the next free one.
INSTANCE_PORT_BASE=18500

# Country code prepended to 10-11-digit national numbers (55, 1, 34...). Empty = national numbers are rejected.
DEFAULT_COUNTRY_CODE=

# Comma-separated browser origins allowed on CORS and WebSocket. Empty = any origin.
ALLOWED_ORIGINS=

# 1 = instance logs also on the manager's stdout (they are always available in the panel).
VERBOSE=1

# 1 = x11vnc on 127.0.0.1:5900 to watch the Chrome windows (tunnel with SSH).
VNC=0

# Video profile sent to the contact: realtime (640x360, 24 fps — default for hosting), balanced (960x540) or hd (1280x720).
ZAPCALL_VIDEO_PROFILE=realtime
